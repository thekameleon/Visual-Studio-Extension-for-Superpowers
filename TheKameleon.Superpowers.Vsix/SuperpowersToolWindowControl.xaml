<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml">
    <Border Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}">
        <Border.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="0.75" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Border.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel IsEnabled="{Binding IsIdle}" MaxWidth="620" HorizontalAlignment="Left" Margin="16,14,16,16">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <vs:Image Grid.Column="0" Source="Superpowers" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Top" AutomationProperties.Name="Superpowers" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Superpowers for GitHub Copilot" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Installation" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding InstalledText}" Style="{StaticResource Hint}" Margin="0,2,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Release" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding ReleaseVersions}"
                                      SelectedItem="{Binding SelectedReleaseVersion, Mode=TwoWay}"
                                      AutomationProperties.Name="Superpowers release" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Command="{Binding CheckForUpdatesCommand}" Content="List all GitHub releases" AutomationProperties.Name="List all Superpowers releases published on GitHub" />

                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Command="{Binding InstallCommand}" Content="Install" FontWeight="SemiBold" AutomationProperties.Name="Install the selected Superpowers release" />
                            <Button Command="{Binding RepairCommand}" Content="Repair" AutomationProperties.Name="Repair the Superpowers installation" />
                            <Button Command="{Binding RemoveCommand}" Content="Remove from my profile" AutomationProperties.Name="Remove Superpowers from your profile" />
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding AlwaysOn, Mode=OneWay}" Command="{Binding ToggleAlwaysOnCommand}" Margin="0,6,0,4" AutomationProperties.Name="Always-on Superpowers" ToolTip="Use Superpowers in every Agent-mode chat">
                            <TextBlock Text="Always on (use Superpowers in every Agent-mode chat)" Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
                        </CheckBox>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Status" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" />
                            <Button Command="{Binding RefreshCommand}" Content="Refresh" Margin="0" AutomationProperties.Name="Refresh Superpowers status" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" AutomationProperties.Name="{Binding Level}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFD69E00" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="OK">
                                                            <Setter Property="Background" Value="#FF2E9E44" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Problem">
                                                            <Setter Property="Background" Value="#FFD13438" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Symbol}" Foreground="White" FontFamily="Segoe UI Symbol" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Copilot CLI" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Skills that dispatch subagents hand the work to the GitHub Copilot CLI. Install it and sign in once." Style="{StaticResource Hint}" Margin="0,2,0,10" />
                        <WrapPanel>
                            <Button Command="{Binding InstallCopilotCliCommand}" Content="Install Copilot CLI" AutomationProperties.Name="Install the GitHub Copilot CLI" />
                            <Button Command="{Binding SignInCopilotCliCommand}" Content="Sign in" AutomationProperties.Name="Sign in to the GitHub Copilot CLI" />
                            <Button Command="{Binding VerifyCopilotCliCommand}" Content="Verify sign-in" ToolTip="Sends one small test prompt to the Copilot CLI (uses one Copilot request)" AutomationProperties.Name="Verify the Copilot CLI sign-in with a test prompt" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Using Superpowers" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Tips}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x2022;" Opacity="0.75" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Model preferences" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Optional. Sets which Copilot model each Superpowers function's agent should use. This is advisory only &#x2014; the extension cannot verify which models are actually enabled on your plan." Style="{StaticResource Hint}" Margin="0,2,0,4" />
                        <TextBlock Text="{Binding ModelCatalogStatusText}" Style="{StaticResource Hint}" FontStyle="Italic" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Your Copilot plan" Style="{StaticResource FieldLabel}" />
                            <ComboBox Width="180" Margin="0,0,6,0" ItemsSource="{Binding PlanOptions}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}" AutomationProperties.Name="Your Copilot plan" />
                            <Button Command="{Binding RefreshModelCatalogCommand}" Content="Refresh model list" Margin="0" AutomationProperties.Name="Refresh the Copilot model list from GitHub" />
                        </StackPanel>
                        <Grid Margin="0,0,0,4" Opacity="0.75">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Function" />
                            <TextBlock Grid.Column="1" Text="Provider" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="2" Text="Model" Margin="8,0,0,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding FunctionRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.FunctionOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding Function, Mode=TwoWay}" AutomationProperties.Name="Superpowers function" />
                                        <TextBlock Grid.Column="1" Text="{Binding Provider}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Model provider" />
                                        <ComboBox Grid.Column="2" IsEditable="True" Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.ModelNameOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="8,0,6,0" AutomationProperties.Name="Model name" />
                                        <Button Grid.Column="3" Command="{Binding DataContext.RemovePreferenceRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="Remove" MinWidth="0" Margin="0" AutomationProperties.Name="Remove this model preference row" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding AddPreferenceRowCommand}" Content="Add row" AutomationProperties.Name="Add a model preference row" />
                            <Button Command="{Binding SaveModelPreferencesCommand}" Content="Save model preferences" FontWeight="SemiBold" AutomationProperties.Name="Save model preferences" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</DataTemplate>
