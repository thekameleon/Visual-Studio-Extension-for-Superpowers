<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <SuperpowersBuildRole>Consumer</SuperpowersBuildRole>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SuperpowersToolWindowControl.xaml" />
    <Page Remove="SuperpowersToolWindowControl.xaml" />
    <Content Include="..\bundled-catalog\obra.superpowers\2026-09-21\**\*"
             Link="bundled-catalog\obra.superpowers\2026-09-21\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             IncludeInVSIX="true" />
    <ProjectReference Include="..\TheKameleon.Superpowers.InProcess\TheKameleon.Superpowers.InProcess.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework"
                      IncludeOutputGroupsInVSIX=""
                      IncludeOutputGroupsInVSIXLocalOnly=""
                      IncludeAssets="none"
                      PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\build\BridgeDebugDeployment.targets" />
  <Import Project="..\build\SuperpowersBuildVersion.targets" />
</Project>
