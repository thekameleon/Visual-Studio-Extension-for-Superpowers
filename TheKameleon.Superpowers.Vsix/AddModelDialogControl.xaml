<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <StackPanel Margin="12" MinWidth="360"
                TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}">
        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ComboBox IsEditable="True"
                  ItemsSource="{Binding ModelOptions}"
                  Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  AutomationProperties.Name="Model to suggest" />
    </StackPanel>
</DataTemplate>
