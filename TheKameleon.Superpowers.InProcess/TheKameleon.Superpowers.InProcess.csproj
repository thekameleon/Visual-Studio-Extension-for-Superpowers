<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <SuperpowersBuildRole>Owner</SuperpowersBuildRole>
    <IsPackable>false</IsPackable>
    <DeployExtension Condition="'$(DeployExtension)' == ''">false</DeployExtension>
    <OutDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\</OutDir>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\</IntermediateOutputPath>
    <TargetVsixContainerName>TheKameleon.Superpowers.InProcess.vsix</TargetVsixContainerName>
    <CreatePkgDefAssemblyToProcess>$(OutDir)$(AssemblyName).dll</CreatePkgDefAssemblyToProcess>
    <CreateVsixContainer>true</CreateVsixContainer>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeCopyLocalReferencesInVSIXContainer>false</IncludeCopyLocalReferencesInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <UseCodebase>true</UseCodebase>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.9" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheKameleon.Superpowers.Bridge.Contracts\TheKameleon.Superpowers.Bridge.Contracts.csproj">
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup</IncludeOutputGroupsInVSIX>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="SuperpowersBridge.vsct" />
    <Content Include="source.extension.vsixmanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <Target Name="BuildVsixContainer" AfterTargets="Build" DependsOnTargets="GeneratePkgDef;VSCTCompile;CreateVsixContainer" />

  <Import Project="$(NuGetPackageRoot)microsoft.vssdk.buildtools\17.14.2142\tools\VSSDK\Microsoft.VsSDK.targets" />

  <PropertyGroup>
    <BridgeNativeDebugDeployment>true</BridgeNativeDebugDeployment>
  </PropertyGroup>
  <Import Project="..\build\BridgeDebugDeployment.targets" />
  <Import Project="..\build\SuperpowersBuildVersion.targets" />

  <Target Name="ValidateBridgeDebugDeployment" BeforeTargets="GetVsixDeploymentPath;DeployVsixExtensionFiles" Condition="'$(DeployExtension)' == 'true' Or '$(BridgeDebugDeployment)' == 'true'">
    <Error Condition="'$(BridgeDebugDeployment)' != 'true'" Text="Bridge deployment requires explicit opt-in. Use scripts/Prepare-BridgeDebug.ps1." />
    <Error Condition="'$(Configuration)' != 'Debug'" Text="Bridge debug deployment requires Configuration=Debug." />
    <Error Condition="'$(VSSDKTargetPlatformRegRootSuffix)' != 'Exp'" Text="Bridge debug deployment is restricted to RootSuffix=Exp; normal IDE profiles are not allowed." />
    <Error Condition="'$(DeployTargetInstanceId)' == ''" Text="Bridge debug deployment requires an explicit DeployTargetInstanceId." />
    <Error Condition="'$(MSBuildRuntimeType)' != 'Full'" Text="Bridge debug deployment requires Visual Studio MSBuild.exe, not dotnet build." />
    <Error Condition="'$(DeployExtension)' != 'true' Or '$(CreateVsixContainer)' != 'true'" Text="Bridge debug deployment requires DeployExtension=true and CreateVsixContainer=true." />
  </Target>

  <Target Name="PrepareBridgeDebug" DependsOnTargets="ValidateBridgeDebugDeployment;Build;DeployVsixExtensionFiles">
    <Error Condition="'$(BridgeDebugDeployment)' != 'true'" Text="Use scripts/Prepare-BridgeDebug.ps1 to select the experimental instance explicitly." />
  </Target>

</Project>
