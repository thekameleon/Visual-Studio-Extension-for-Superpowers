<Project>
	<PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true' And '$(BridgeNativeDebugDeployment)' == 'true'">
		<_BridgeSavedDebuggerFlavor>$(DebuggerFlavor)</_BridgeSavedDebuggerFlavor>
		<_BridgeSavedActiveDebugProfile>$(ActiveDebugProfile)</_BridgeSavedActiveDebugProfile>
		<BridgeDebugSelectionFile>$(MSBuildThisFileDirectory)..\TheKameleon.Superpowers.Vsix\TheKameleon.Superpowers.Vsix.csproj.user</BridgeDebugSelectionFile>
	</PropertyGroup>
	<Import Project="$(BridgeDebugSelectionFile)"
					Condition="'$(BuildingInsideVisualStudio)' == 'true' And '$(BridgeNativeDebugDeployment)' == 'true' And Exists('$(BridgeDebugSelectionFile)')" />
	<PropertyGroup Condition="'$(BridgeNativeDebugDeployment)' == 'true'">
		<DebuggerFlavor>$(_BridgeSavedDebuggerFlavor)</DebuggerFlavor>
		<ActiveDebugProfile>$(_BridgeSavedActiveDebugProfile)</ActiveDebugProfile>
		<VsixDeployOnDebug>false</VsixDeployOnDebug>
		<VSSDKTargetPlatformRegRootSuffix Condition="'$(VSSDKTargetPlatformRegRootSuffix)' == ''">Exp</VSSDKTargetPlatformRegRootSuffix>
		<VsixDeployOnDebug Condition="'$(BuildingInsideVisualStudio)' == 'true' And '$(Configuration)' == 'Debug' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(DeployTargetInstanceId)', '^[a-zA-Z0-9_-]+$')) And '$(VSSDKTargetPlatformRegRootSuffix)' == 'Exp' And ('$(RootSuffix)' == '' Or '$(RootSuffix)' == 'Exp')">true</VsixDeployOnDebug>
	</PropertyGroup>
	<Target Name="ValidateNativeBridgeDebugTarget"
					BeforeTargets="PrepareForBuild"
					Condition="'$(BuildingInsideVisualStudio)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(Configuration)' == 'Debug'">
		<Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeployTargetInstanceId)', '^[a-zA-Z0-9_-]+$'))"
					 Text="Select an explicit Visual Studio installation (DeployTargetInstanceId) in the modern VSIX Debug properties before F5; the bridge uses that same selection." />
		<Error Condition="('$(VSSDKTargetPlatformRegRootSuffix)' != '' And '$(VSSDKTargetPlatformRegRootSuffix)' != 'Exp') Or ('$(RootSuffix)' != '' And '$(RootSuffix)' != 'Exp')"
					 Text="Superpowers native debug deployment supports the Exp profile only." />
		<Message Importance="High" Text="Superpowers native F5 deployment configured: instance $(DeployTargetInstanceId), profile Exp. The solution Deploy phase installs both VSIX projects; building alone does not install them." />
  </Target>
</Project>
